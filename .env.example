# Which LLM powers the agents: gemini | groq | anthropic | openai | watsonx
# gemini and groq are FREE, no credit card required — recommended if you're on a budget.
LLM_PROVIDER=groq

# Set the key matching your provider
GEMINI_API_KEY=AQ.Ab8RN6INh96go23xcwuJxZZYflE8eUypqF_tallpBk2QaIRMww
GROQ_API_KEY=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
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Local path to the repo you want Impact Engine to analyze and modify.
# Clone a sample or your own project and point this at it.
TARGET_REPO_PATH=./sample-repo

# Optional: only needed if you want it to actually push a branch and open a
# real PR via GitHub. If left blank, it still writes the commit locally so
# you can demo the diff.
GITHUB_TOKEN=
GITHUB_REPO=yourname/your-repo

PORT=3000
